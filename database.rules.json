{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'console@console.stellatd.game')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'console@console.stellatd.game')"
      }
    },
    "public": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'console@console.stellatd.game')"
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'console@console.stellatd.game')"
      }
    },
    "bans": {
      ".read": "auth != null && auth.token.email === 'console@console.stellatd.game'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email === 'console@console.stellatd.game'"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'console@console.stellatd.game'"
    },
    "roles": {
      ".read": "auth != null",
      ".write": "false"
    },
    "logs": {
      ".read": "auth != null && auth.token.email === 'console@console.stellatd.game'",
      "$id": {
        ".write": "auth != null && auth.token.email === 'console@console.stellatd.game' && !data.exists()",
        ".validate": "newData.hasChildren(['by', 't', 'msg'])"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $other)"
        }
      }
    },
    "friendReq": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "invites": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $uid)"
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('meta/host').val() === auth.uid)"
          }
        },
        "gifts": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($code).child('members').child(auth.uid).exists())"
          }
        }
      }
    },
    "codes": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'console@console.stellatd.game'",
      "$code": {
        "used": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()"
          }
        }
      }
    },
    "bossDmg": {
      "$boss": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.isNumber()"
        }
      },
      ".write": "auth != null && auth.token.email === 'console@console.stellatd.game'"
    },
    "market": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('seller').val() === auth.uid && !newData.child('buyer').exists()) || (!newData.exists() && (data.child('buyer').val() === auth.uid || auth.token.email === 'console@console.stellatd.game')))",
        "buyer": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        }
      }
    },
    "mail": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === $uid && !newData.exists()) || auth.token.email === 'console@console.stellatd.game')"
        }
      }
    },
    "tradeIn": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".read": "auth != null && data.child('from').val() === auth.uid",
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid && newData.child('to').val() === $to && !newData.child('state').exists()) || (!newData.exists() && data.child('state').exists() && (auth.uid === $to || data.child('from').val() === auth.uid)))",
          "state": {
            ".write": "auth != null && !data.exists() && newData.isString() && (auth.uid === $to || data.parent().child('from').val() === auth.uid)"
          }
        }
      }
    },
    "tradeOut": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "chat": {
      ".write": "auth != null && auth.token.email === 'console@console.stellatd.game'",
      "world": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('msg').isString() && newData.child('msg').val().length <= 200 && newData.child('t').isNumber()) || auth.token.email === 'console@console.stellatd.game')"
        }
      },
      "dm": {
        "$pair": {
          ".read": "auth != null && $pair.contains(auth.uid)",
          "$id": {
            ".write": "auth != null && $pair.contains(auth.uid) && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('msg').isString() && newData.child('msg').val().length <= 200 && newData.child('t').isNumber()"
          }
        }
      }
    },
    "dmNew": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)"
        }
      }
    }
  }
}
